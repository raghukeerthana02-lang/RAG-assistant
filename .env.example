SUPABASE_URL=
SUPABASE_SERVICE_KEY=

GROQ_API_KEY=

# Optional. Leave blank to run without error tracking.
SENTRY_DSN=

# Comma-separated list of frontend origins allowed to call this API.
# Defaults to http://localhost:5174 if left blank.
ALLOWED_ORIGINS=http://localhost:5174

# Optional. redis:// URL for shared rate-limit storage across multiple
# worker processes/instances. Leave blank for single-worker in-memory limits.
REDIS_URL=

# Optional. Where FAISS indexes are persisted. Defaults to ./faiss_store.
# Point this at a mounted persistent volume in production.
FAISS_STORE_DIR=